{"name": "glued unit, altered value", "edits": [{"path": "wiki/entities/trappist-1e.md", "old": "- Radius: about 0.92 Earth radii.[^e]", "new": "- Radius: about 0.93R.[^e]"}], "expect": "error", "contains": "0.93"}
{"name": "glued unit, same value", "edits": [{"path": "wiki/entities/trappist-1e.md", "old": "- Radius: about 0.92 Earth radii.[^e]", "new": "- Radius: about 0.92R.[^e]"}], "expect": "clean"}
