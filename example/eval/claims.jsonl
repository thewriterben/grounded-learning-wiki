{"name": "quote of the number alone", "edits": [{"path": "wiki/entities/trappist-1e.md", "append": "[^n]: raw/trappist-1-note.md \"0.92\"\n"}, {"path": "wiki/entities/trappist-1e.md", "old": "- Radius: about 0.92 Earth radii.[^e]", "new": "- Radius: about 0.92 Earth radii.[^n]"}], "expect": "error", "contains": "at least 3 words"}
{"name": "quote not in the source", "edits": [{"path": "wiki/entities/trappist-1e.md", "append": "[^x]: raw/trappist-1-note.md \"TRAPPIST-1e has a radius of about 0.95 Earth radii\"\n"}, {"path": "wiki/entities/trappist-1e.md", "old": "- Radius: about 0.92 Earth radii.[^e]", "new": "- Radius: about 0.95 Earth radii.[^x]"}], "expect": "error", "contains": "word for word"}
{"name": "external citation is flagged for a human", "edits": [{"path": "wiki/entities/trappist-1e.md", "append": "[^d]: doi:10.0000/demo \"TRAPPIST-1e has a radius of about 0.91 Earth radii\"\n"}, {"path": "wiki/entities/trappist-1e.md", "old": "- Radius: about 0.92 Earth radii.[^e]", "new": "- Radius: about 0.91 Earth radii.[^d]"}], "expect": "warn", "contains": "cannot be checked locally"}
{"name": "learning page number not on the linked page", "edits": [{"path": "wiki/learning/daily/daily-2026-11-06.md", "old": "about 0.92 Earth radii", "new": "about 0.93 Earth radii"}], "expect": "error", "contains": "0.93"}
{"name": "source edited to match", "edits": [{"path": "raw/trappist-1-note.md", "old": "about 0.92", "new": "about 0.95"}, {"path": "wiki/entities/trappist-1e.md", "old": "0.92", "new": "0.95"}, {"path": "wiki/entities/trappist-1e.md", "old": "0.92", "new": "0.95"}], "expect": "error", "contains": "changed since it was locked"}
